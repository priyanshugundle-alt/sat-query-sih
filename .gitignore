# Build output
backend/target/
frontend/dist/
dist/

# Local environment variables & API keys
.env
*.env
# model_server/.env is tracked so default template is shared across team
!model_server/.env
backend/.env
frontend/.env

# Local databases and SQLite runtime
*.db
*.db-journal
*.sqlite3
backend/*.db
backend/*.db-journal
satquery.db

# File uploads and reports generated during runtime
backend/uploads/*
!backend/uploads/.gitkeep
backend/outputs/*
!backend/outputs/.gitkeep

# Root-level uploads folder - runtime satellite imagery (never commit these)
uploads/*
!uploads/.gitkeep

# Presentation outputs
*.pptx

# IDE files
.vscode/
.manus-logs/

# Dependencies
node_modules/
frontend/node_modules/

# Python virtual environments
.venv/
venv/
env/
*.egg-info/

# Java crash logs & output masks
hs_err_pid*.log
outputs/*.png
samples/test_t1.png
samples/test_t2.png

# OS specific files
.DS_Store
Thumbs.db

# Large model binaries & weights
model_server/model_weights/
backend/trained_models/*.safetensors
backend/trained_models/*.bin
backend/trained_models/*.pth

# Python Cache & Bytecode
**/__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/

# Datasets & Large Metadata
BigEarthNet-S1/
BigEarthNet.txt/
*.parquet
model_a_audit.txt
model_a/cache/*.json
!model_a/cache/.gitkeep

# Checkpoints: Exclude temporary intermediate runs, keep best & unified fusion
model_a/checkpoints/*INVALID_PREFIX*
model_a/checkpoints/latest_checkpoint*.pt
model_a/checkpoints/best_model_a_weighted.pt

# Temporary scratch directory
scratch/

# Large zip bundles
exports/*.zip

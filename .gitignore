# Build output
backend/target/
frontend/dist/
dist/

# Local databases and SQLite runtime
backend/*.db
backend/*.db-journal

# File uploads and reports generated during runtime
backend/uploads/*
!backend/uploads/.gitkeep
backend/outputs/*
!backend/outputs/.gitkeep

# IDE files
.vscode/
.idea/
.manus-logs/

# Dependencies
node_modules/
frontend/node_modules/

# OS specific files
.DS_Store
Thumbs.db

# Python Virtual Environments
.venv/
venv/
env/
ENV/

# Python Cache & Bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/

# Datasets & Large Metadata
BigEarthNet-S1/
*.parquet
model_a_audit.txt
model_a/cache/*.json
!model_a/cache/.gitkeep

# Checkpoints: Exclude temporary intermediate runs, keep best & unified fusion
model_a/checkpoints/*INVALID_PREFIX*
model_a/checkpoints/latest_checkpoint*.pt
model_a/checkpoints/best_model_a_weighted.pt

# Temporary scratch directory
scratch/

# Large zip bundles
exports/*.zip

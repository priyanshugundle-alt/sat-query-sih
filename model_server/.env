# SatQuery AI - Local Environment API Keys (Git-Ignored)

# 1. Google Gemini API Key (Recommended for Vision VQA / Fusion - Free Tier: 1,500 req/day)
# Link: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# 2. GroqCloud API Key (Recommended for Ultra-Fast Text Change Reasoning - Free Tier: 1,000 req/day)
# Link: https://console.groq.com/keys
GROQ_API_KEY=

# 3. OpenRouter API Key (Universal Free Multi-Model Key)
# Link: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# 4. NVIDIA NIM API Key
# Link: https://build.nvidia.com/
NVIDIA_API_KEY=

# 5. OpenAI API Key
OPENAI_API_KEY=

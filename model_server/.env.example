# SatQuery AI - Cloud VLM / LLM API Key Configuration
# Place your API key below. Supports Gemini, OpenAI, or OpenRouter.
# This file (.env) is added to .gitignore and will NOT be committed.

# Option 1: Google Gemini API Key (Recommended)
GEMINI_API_KEY=

# Option 2: OpenAI API Key
# OPENAI_API_KEY=your_openai_api_key_here

# Option 3: OpenRouter API Key
# OPENROUTER_API_KEY=your_openrouter_api_key_here
